{
  "name": "fashion-marketplace",
  "version": "1.0.0",
  "description": "Enterprise-grade multi-vendor fashion e-commerce marketplace",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:services\" \"npm run dev:web\"",
    "dev:services": "node scripts/devops/start-services.js",
    "dev:web": "node apps/web/src/js/server.js",
    "build": "npm run build:services && npm run build:web",
    "build:services": "node scripts/devops/build-services.js",
    "build:web": "node scripts/devops/build-web.js",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "jest --config packages/config/jest/jest.unit.config.js",
    "test:integration": "jest --config packages/config/jest/jest.integration.config.js",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.js",
    "lint": "eslint . --ext .js,.jsx --config packages/config/eslint/.eslintrc.js",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\" --config packages/config/prettier/.prettierrc",
    "db:migrate": "node scripts/db/run-migrations.js",
    "db:seed": "node scripts/db/seed-databases.js",
    "db:backup": "node scripts/db/backup.js",
    "docker:up": "docker-compose -f infrastructure/docker/docker-compose.yml up -d",
    "docker:down": "docker-compose -f infrastructure/docker/docker-compose.yml down",
    "k8s:deploy:dev": "kubectl apply -k infrastructure/k8s/overlays/dev",
    "k8s:deploy:staging": "kubectl apply -k infrastructure/k8s/overlays/staging",
    "k8s:deploy:prod": "kubectl apply -k infrastructure/k8s/overlays/prod"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "jest": "^29.7.0",
    "@playwright/test": "^1.40.1",
    "nodemon": "^3.0.2",
    "cross-env": "^7.0.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/organization/fashion-marketplace.git"
  },
  "author": "Enterprise Architecture Team",
  "license": "UNLICENSED"
}
