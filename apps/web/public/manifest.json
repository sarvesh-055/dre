{
  "name": "@fashion-marketplace/web-pwa",
  "short_name": "FashionMarket",
  "description": "Fashion Marketplace - Discover trending fashion from top vendors",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#FFFFFF",
  "theme_color": "#FF6B6B",
  "categories": ["shopping", "lifestyle", "fashion"],
  "lang": "en-US",
  "dir": "ltr",
  "icons": [
    {
      "src": "/images/icons/icon-72x72.png",
      "sizes": "72x72",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/images/icons/icon-96x96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/images/icons/icon-128x128.png",
      "sizes": "128x128",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/images/icons/icon-144x144.png",
      "sizes": "144x144",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/images/icons/icon-152x152.png",
      "sizes": "152x152",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/images/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/images/icons/icon-384x384.png",
      "sizes": "384x384",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/images/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/images/screenshots/home-desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Home Page Desktop"
    },
    {
      "src": "/images/screenshots/home-mobile.png",
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Home Page Mobile"
    },
    {
      "src": "/images/screenshots/product-detail.png",
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Product Detail Page"
    },
    {
      "src": "/images/screenshots/cart.png",
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Shopping Cart"
    }
  ],
  "shortcuts": [
    {
      "name": "New Arrivals",
      "short_name": "New",
      "description": "Browse latest fashion arrivals",
      "url": "/collections/new-arrivals",
      "icons": [
        {
          "src": "/images/icons/shortcut-new.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Best Sellers",
      "short_name": "Popular",
      "description": "Shop trending fashion items",
      "url": "/collections/best-sellers",
      "icons": [
        {
          "src": "/images/icons/shortcut-popular.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Offers & Deals",
      "short_name": "Deals",
      "description": "Exclusive discounts and offers",
      "url": "/offers",
      "icons": [
        {
          "src": "/images/icons/shortcut-deals.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "My Orders",
      "short_name": "Orders",
      "description": "Track your orders",
      "url": "/account/orders",
      "icons": [
        {
          "src": "/images/icons/shortcut-orders.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "images",
          "accept": ["image/*"]
        }
      ]
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+fm",
      "url": "/protocol/%s"
    }
  ],
  "related_applications": [],
  "prefer_related_applications": false,
  "iarc_rating_id": "",
  "edge_side_panel": {
    "preferred_width": 400
  },
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "file_handlers": [
    {
      "action": "/import-cart",
      "accept": {
        "application/json": [".json"]
      },
      "icons": [
        {
          "src": "/images/icons/import-icon.png",
          "sizes": "128x128",
          "type": "image/png"
        }
      ]
    }
  ],
  "capture_links": "client-navigate",
  "navigation_handlers": [
    {
      "origin": "https://fashionmarketplace.com",
      "paths": ["/checkout/*"]
    }
  ]
}
